# Copy to .env and fill in. Never commit .env.

NODE_ENV=production
PORT=4000

MONGO_URI=mongodb://127.0.0.1:27017/techzar

# Long random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it signs out every admin.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=https://www.techzarinfo.com,https://www.techzarinfo.in

# Where password reset links point to
FRONTEND_URL=https://www.techzarinfo.com
FRONTEND_URLS=https://www.techzarinfo.com,https://www.techzarinfo.in

# Gmail account used to send email (use a Google App Password, not the account password)
MAIL_SERVICE=gmail
MAIL_USER=sales@techzarinfo.com
MAIL_PASS=
MAIL_SALES_ADDRESS=sales@techzarinfo.com
